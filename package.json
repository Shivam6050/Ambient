{
  "name": "ambient",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently --kill-others -n server,client \"npm run dev --prefix server\" \"npm run dev --prefix client -- --host 127.0.0.1 --port 5173 --strictPort\",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client -- --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run build --workspace=client",
    "test": "npm test --prefix server",
    "test:policy": "npm run test:policy --prefix server",
    "test:lifecycle": "npm run test:lifecycle --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^11.2.0"
  }
}
