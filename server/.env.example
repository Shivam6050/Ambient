PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Persistence: Leave blank for automatic in-memory mode, or specify MongoDB connection string.
# Run 'npm run db' from project root to start a persistent local MongoDB instance.
MONGODB_URI=mongodb://127.0.0.1:27017/ambient

# AI Provider: 'mock' (default offline testing), 'jev' (TypeSafe AI), 'bedrock' (AWS Bedrock), or 'rules' (pure deterministic)
AI_PROVIDER=mock

# Jev / TypeSafe AI Configuration (when AI_PROVIDER=jev)
TYPESAFE_API_KEY=your_typesafe_api_key
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone

# AWS Bedrock Configuration (when AI_PROVIDER=bedrock or for v0.8 explanation layer)
AWS_BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
