PORT=5000
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=

AI_PROVIDER=mock
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone

AWS_BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

AMBIENT_AUTO_THRESHOLD=0.80
AMBIENT_REVIEW_THRESHOLD=0.55

# v0.9 MCP
MCP_PORT=5100
MCP_HOST=127.0.0.1

# Alexa+ add-on: simulator by default; use remote only after deploying an Amazon Alexa AI CLI add-on.
ALEXA_PLUS_MODE=simulator
ALEXA_PLUS_ADDON_ID=

# Ring Partner API. Requires Amazon Ring developer onboarding/OAuth credentials.
RING_MODE=simulator
RING_API_BASE_URL=https://api.amazonvision.com
RING_ACCESS_TOKEN=
RING_HMAC_KEY=