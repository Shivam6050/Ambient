PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Optional. Leave empty for zero-setup in-memory mode.
MONGODB_URI=

# Decision provider: mock (recommended for local demo), jev, or rules.
AI_PROVIDER=mock

# Jev / TypeSafe AI
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone

# Optional AWS Builder / Bedrock explanation layer.
# Keep false to avoid AWS calls and charges during local development.
AWS_BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Confidence gate thresholds.
AMBIENT_AUTO_THRESHOLD=0.80
AMBIENT_REVIEW_THRESHOLD=0.55
